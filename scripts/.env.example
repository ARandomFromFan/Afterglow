# Copy to scripts/.env and set your own paths. scripts/.env is gitignored.
# Unset keys fall back to folders inside the repo (work/, game/).

# Build output: lifted C, objects, duskbloods_game, afterglow_vk.so, sa/image/image.bin
WORK_DIR=~/afterglow/work

# Your game dump, with exefs/ and romfs/ inside
GAME_DIR=~/afterglow/game


# Optional, for the Lichii capture scripts: a TOML with the Lichii source (rev, patches)
# and the dotted key of that table inside it
# LICHII_SOURCE_TOML=~/lichii.toml
# LICHII_SOURCE_KEY=source
# EDEN_CONFIG=~/.config/eden/qt-config.ini
